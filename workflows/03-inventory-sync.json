{
  "name": "03 - Inventory Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "id": "307ae2793de167af",
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sku, supplier_stock, takealot_stock, reserved_stock FROM inventory",
        "options": {}
      },
      "id": "2fbe573d99155dfc",
      "name": "Read Stock Table",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TAKEALOT_API_BASE_URL }}/{{ $env.TAKEALOT_API_VERSION }}/offers",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.TAKEALOT_API_KEY }}"
            }
          ]
        },
        "sendQueryParameters": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "page_number",
              "value": "1"
            },
            {
              "name": "page_size",
              "value": "100"
            }
          ]
        }
      },
      "id": "97ebfda49d0e8f3c",
      "name": "Fetch Takealot Offers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const local = $('Read Stock Table').all().map(i => i.json);\n        const body = $input.first().json;\n        const offers = body.offers || body.data?.offers || [];\n        const remote = {};\n        for (const o of offers) {\n          const sku = String(o.sku || o.merchant_sku || '').trim();\n          if (sku) remote[sku] = o;\n        }\n        const out = [];\n        for (const l of local) {\n          const o = remote[l.sku];\n          if (!o) continue;\n          const available = Math.max(0, Number(l.supplier_stock || 0) - Number(l.reserved_stock || 0));\n          const current = Number(o.seller_stock ?? o.stock_total ?? 0);\n          if (available !== current) {\n            out.push({ json: {\n              sku: l.sku,\n              offer_id: Number(o.offer_id || o.id || 0),\n              quantity: available,\n              remote_stock: current\n            }});\n          }\n        }\n        return out;",
        "mode": "runOnceForAllItems"
      },
      "id": "95b6ca9ef2b0684f",
      "name": "Reconcile Stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const updates = $input.all().map(i => i.json);\n        return [{ json: { count: updates.length, updates } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "5ca81ce022a3468c",
      "name": "Count Updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "rule-1",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "316e92d9421dc6af",
      "name": "Stock Differences?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TAKEALOT_API_BASE_URL }}/{{ $env.TAKEALOT_API_VERSION }}/offers/batch",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.TAKEALOT_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({ offers: $('Count Updates').first().json.updates.map(u => ({\n          sku: u.sku,\n          leadtime_stock: [{\n            merchant_warehouse_id: Number($env.TAKEALOT_WAREHOUSE_ID || 1),\n            quantity: u.quantity\n          }]\n        })) }) }}"
      },
      "id": "dd5dd57909eb5f9f",
      "name": "Batch Update Stock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "return $('Count Updates').first().json.updates;",
        "mode": "runOnceForAllItems"
      },
      "id": "2210d29d9b17d446",
      "name": "Flatten Updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -120
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE inventory\n        SET takealot_stock = {{ $json.quantity }}, updated_at = now()\n        WHERE sku = '{{ $json.sku }}'",
        "options": {}
      },
      "id": "d224b6249e6dcd38",
      "name": "Save Local Stock",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1760,
        -120
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO automation_log (workflow, level, message, details)\n        VALUES ('inventory-sync', 'info', 'Stock sync completed',\n                '{{ JSON.stringify($(\"Count Updates\").first().json.updates).replace(/'/g, \"''\") }}'::jsonb)",
        "options": {}
      },
      "id": "4243166920c17e4c",
      "name": "Log Sync",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1980,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "options": {},
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({ text: 'Stock sync: ' + $('Count Updates').first().json.count + ' offers updated' }) }}"
      },
      "id": "34078ec199d9fce5",
      "name": "Notify Stock Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        -120
      ]
    },
    {
      "parameters": {},
      "id": "8b6840eb631d7d5e",
      "name": "Stock In Sync",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
        180
      ]
    }
  ],
