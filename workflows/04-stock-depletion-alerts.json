{
  "name": "04 - Stock Depletion Alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */2 * * *"
            }
          ]
        }
      },
      "id": "e91fea5ec1f8a25c",
      "name": "Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sku, product_title, stock_total, selling_price, cost_price\n        FROM offers\n        WHERE stock_total <= {{ $env.LOW_STOCK_THRESHOLD }}\n        ORDER BY stock_total ASC\n        LIMIT 100",
        "options": {}
      },
      "id": "abbea62bc2b590e7",
      "name": "Low Stock Query",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n        const lines = rows.map(r => '• ' + r.sku + ' - ' + (r.product_title || '') + ': ' + r.stock_total + ' left');\n        return [{ json: {\n          count: rows.length,\n          rows,\n          text: 'Takealot low stock alert\\n' + lines.join('\\n'),\n          html: '<h2>Low stock (' + rows.length + ')</h2><ul>' + lines.map(l => '<li>' + l + '</li>').join('') + '</ul>'\n        }}];",
        "mode": "runOnceForAllItems"
      },
      "id": "d0925f09b0f5fef8",
      "name": "Format Low Stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "rule-1",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "15187b080fdc99dd",
      "name": "Any Low Stock?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "options": {},
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}"
      },
      "id": "23e2ff351c8077e9",
      "name": "Slack Low Stock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -120
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM_EMAIL }}",
        "toEmail": "={{ $env.ALERT_EMAIL }}",
        "subject": "={{ 'Low stock alert - ' + $json.count + ' offers' }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "61f791527743144a",
      "name": "Email Low Stock",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        -120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "rule-1",
              "leftValue": "={{ $env.WHATSAPP_TOKEN }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "313685a3bbd23dc1",
      "name": "WhatsApp Configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $env.WHATSAPP_RECIPIENT, type: 'text', text: { body: $('Format Low Stock').first().json.text.slice(0, 4000) } }) }}"
      },
      "id": "bfda034c9f5ebfe6",
      "name": "WhatsApp Low Stock",
