      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\n        return [{ json: {\n          ok: true,\n          offer_count: body.count ?? body.total ?? 0,\n          raw: JSON.stringify(body).slice(0, 500)\n        }}];",
        "mode": "runOnceForAllItems"
      },
      "id": "ac193c71faf023ae",
      "name": "Summarise Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "options": {},
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({ text: 'Takealot API health check OK. Offers: ' + $json.offer_count }) }}"
      },
      "id": "c537affd547dd5f6",
      "name": "Notify Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
